# Application Settings
APP_NAME="Smart Event Ticketing System"
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production-min-32-chars
HOST=127.0.0.1
PORT=8000

# Database Configuration
# For MySQL (Laragon default user 'root' with empty password):
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/smart_ticketing?charset=utf8mb4
# Default development fallback:
DATABASE_URL=sqlite:///./storage/smart_ticketing.db

# Storage Directories
PRIVATE_FACES_DIR=./storage/private_faces
FEATURES_DIR=./storage/features
MODEL_ARTIFACTS_DIR=./storage/model_artifacts

# Security & Session Settings
SESSION_COOKIE_NAME=smart_ticket_session
SESSION_MAX_AGE_SECONDS=86400
SECURE_COOKIE=false
CSRF_SECRET=change-this-csrf-secret-key-32-chars-long

# Computer Vision & Recognition Defaults
HOG_ORIENTATIONS=9
HOG_PIXELS_PER_CELL=8
HOG_CELLS_PER_BLOCK=2
HOG_BLOCK_NORM=L2-Hys
TARGET_FACE_SIZE=128

# ML Recognition Threshold & Defaults
KNN_DEFAULT_K=3
RECOGNITION_THRESHOLD=0.65
PSO_NUM_PARTICLES=15
PSO_MAX_ITERATIONS=20

